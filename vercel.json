{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/shop/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/shop/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/shop.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/hosting.html",
      "destination": "/hosting",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/playbyear-logo-dark.png",
      "destination": "/Assets/playbyear-logo-dark.png"
    }
  ]
}
